[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/SpellbookUI.gd" id="1_spellbook_ui"]

[node name="SpellbookUI" type="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_spellbook_ui")

[node name="SpellbookVBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="SpellbookStatusLabel" type="Label" parent="SpellbookVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.88, 0.96, 1)
theme_override_font_sizes/font_size = 14
text = "✨ Книга заклинаний: 26 заклинаний (активно максимум 3 слота)."
autowrap_mode = 3

[node name="SpellbookFeedbackLabel" type="Label" parent="SpellbookVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.95, 0.65, 1)
theme_override_font_sizes/font_size = 13
text = ""
autowrap_mode = 3

[node name="ActiveSlotsHeader" type="Label" parent="SpellbookVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.84, 0.36, 1)
theme_override_font_sizes/font_size = 15
text = "🎯 Активные слоты в бою (максимум 3):"

[node name="ActiveSlotsHBox" type="HBoxContainer" parent="SpellbookVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="SpellListHeader" type="Label" parent="SpellbookVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.85, 1, 1)
theme_override_font_sizes/font_size = 15
text = "📖 Все заклинания (26 шт. — 19 общих + 7 Архимага Крови):"

[node name="SpellListVBox" type="VBoxContainer" parent="SpellbookVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10
