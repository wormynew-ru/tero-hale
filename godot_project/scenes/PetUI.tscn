[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/PetUI.gd" id="1_pet_ui"]

[node name="PetUI" type="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_pet_ui")

[node name="PetVBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="PetStatusLabel" type="Label" parent="PetVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.9, 0.98, 1)
theme_override_font_sizes/font_size = 14
text = "🐾 Путников нельзя купить за золото — приманивайте их в ☀️ Светлом саду и дрессируйте пряниками из урожая!"
autowrap_mode = 3

[node name="PetFeedbackLabel" type="Label" parent="PetVBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.95, 0.68, 1)
theme_override_font_sizes/font_size = 13
text = ""
autowrap_mode = 3

[node name="ActivePetPanel" type="PanelContainer" parent="PetVBox"]
layout_mode = 2

[node name="ActivePetRow" type="HBoxContainer" parent="PetVBox/ActivePetPanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ActivePetLabel" type="Label" parent="PetVBox/ActivePetPanel/ActivePetRow"]
