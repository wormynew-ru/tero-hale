[resource]
script = ExtResource("1_loc")
id = "abandoned_mine"
location_name = "Древняя Шахта"
icon_emoji = "⛏️"
description = "Опасная выработка на 1 ЗАХОД за ран! Здесь добываются ⛏️ Руда Бездны и 📜 Древние листы (и во время боя, и с врагов). При смерти доступ в Шахту закрывается до Нового рана!"
required_level = 3
required_difficulty = 1
always_open_once_unlocked = false
is_one_attempt_mine = true
enemies = Array[ExtResource("2_enemy_script")]([ExtResource("3_kobold"), ExtResource("4_golem"), ExtResource("5_spider"), ExtResource("6_overseer")])
background_color = Color(0.11, 0.11, 0.15, 1)
