[resource]
script = ExtResource("1_loc")
id = "ancient_ruins"
location_name = "Древние руины"
icon_emoji = "🏚️"
description = "Забытые катакомбы, охраняемые нежитью и культистами. Здесь добывается железное снаряжение."
