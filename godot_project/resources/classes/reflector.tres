[gd_resource type="Resource" script_class="HeroClassData" format=3]

[ext_resource type="Script" path="res://scripts/resources/HeroClassData.gd" id="1_hclass"]

[resource]
script = ExtResource("1_hclass")
id = "reflector"
title = "Отражатель"
icon_emoji = "🪞"
subtitle = "Бастион шипов и гниения"
description = "Чистый танк-поглотитель: не наносит прямой урон оружием и атакующими заклинаниями, имеет 0% уклонения, но умножает все приросты Max HP на 20 и гасит удар до брони за счёт отражения (до 99%)."
passive_summary = "0 прямого урона | 0% уклонения | Все приросты HP x20 | Дисперсия до брони: отражает 20%+ урона (снижение до 99%, излишек % идёт в урон врагу) | Аура 5% Max HP + 0.1% HP врага срабатывает мгновенно в начале боя и каждую 1с | Барьер 1:1 в Max HP | +30% HP, +40% Брони, стак убийств (сохраняется за Отражателем)"
required_difficulty = 50
accent_color = Color(0.38, 0.85, 0.92, 1)
disables_equipment = false
