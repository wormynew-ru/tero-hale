[gd_resource type="Resource" script_class="HeroClassData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/HeroClassData.gd" id="1_class"]

[resource]
script = ExtResource("1_class")
id = "blood_archmage"
title = "Архимаг Крови"
icon_emoji = "🩸"
subtitle = "Повелитель чар и крови"
description = "Открывает 6 запретных заклинаний крови, кастует чары за полцены маны или за счёт HP и сбрасывает перезарядку ударами."
passive_summary = "• Открывает 6 эксклюзивных заклинаний крови в Книге заклинаний (из 20 общих).\n• +75% к силе всех магических способностей.\n• Стоимость маны снижена на 50%, КД быстрее на 30%.\n• Если маны не хватает — заклинание кастуется за 8% текущего HP!\n• Каждая базовая атака сокращает КД всех заклинаний на 0.5с."
required_difficulty = 50
accent_color = Color(0.84, 0.42, 0.98, 1)
disables_equipment = false
