[gd_resource type="Resource" script_class="HeroClassData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/HeroClassData.gd" id="1_class"]

[resource]
script = ExtResource("1_class")
id = "blood_archmage"
title = "Архимаг Крови"
icon_emoji = "🩸"
subtitle = "Повелитель чар и крови"
description = "При ударе с шансом 10% вместо обычной тычки кастует случайное заклинание из быстрого доступа, обладает 2x приростом Инты и 3x манапулом от Инты, открывает 7 запретных заклинаний крови и кастует чары за полцены маны или за счёт HP."
passive_summary = "• Прирост интеллекта в 2 раза выше (2x ко всей Инте).\n• Маны от интеллекта в 3 раза больше, чем у остальных (96 MP за 1 Инты вместо 32).\n• При ударе с шансом 10% вместо обычной тычки кастует случайное заклинание из слотов быстрого доступа!\n• Открывает 7 эксклюзивных заклинаний крови в Книге заклинаний (из 27 общих).\n• +75% к силе всех магических способностей.\n• Стоимость маны снижена на 50%, КД быстрее на 30%.\n• Если маны не хватает — заклинание кастуется за 8% текущего HP!\n• Каждая атака дополнительно сокращает КД слотов быстрого доступа на 0.5с."
required_difficulty = 50
accent_color = Color(0.84, 0.42, 0.98, 1)
disables_equipment = false
