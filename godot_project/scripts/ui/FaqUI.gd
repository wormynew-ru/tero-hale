extends ScrollContainer

@onready var faq_text: RichTextLabel = %FaqText


func _ready() -> void:
	if faq_text != null:
		faq_text.text = _build_faq_bbcode()


func _build_faq_bbcode() -> String:
	return (
		"[b][color=#facc15]⚔️ Поиск боя и честный автобой[/color][/b]\n"
		+ "• Кнопка [b]⚔️ Поиск боя[/b] по центру экрана запускает сражения в выбранной локации. Пока бой активен, кнопка меняется на [b]🏳️ Отступить[/b].\n"
		+ "• Персонаж сражается полностью самостоятельно в реальном времени — кликами ускорить атаку нельзя.\n\n"
		+ "[b][color=#60a5fa]📘 Learn by Doing (Мастерство из практики)[/color][/b]\n"
		+ "• В игре есть 3 навыка владения, которые качаются сами по мере использования:\n"
		+ "  — [b]⚔️ Ближний бой[/b]: +1 XP за удар оружием ближнего боя (+3% урона за уровень).\n"
		+ "  — [b]🏹 Дальний бой[/b]: +1 XP за выстрел со снарядом (+3.5% урона и +0.3% крита за уровень).\n"
		+ "  — [b]✨ Магия[/b]: +XP равный затраченной мане (заклинание за 20 маны даёт 20 XP; +3.5% силы чар и +4% регена маны за уровень).\n\n"
		+ "[b][color=#34d399]🏹 Дальний бой (Луки, Арбалеты и Снаряды)[/color][/b]\n"
		+ "• Луки используют [b]Стрелы[/b], арбалеты — [b]Болты[/b]. Купите колчан в лавке (пачки по 50 шт.) или выбейте с врагов.\n"
		+ "• При наличии подходящих снарядов они добавляют урон, крит и пробитие брони. Если снаряды закончились — герой бьёт ослабленной атакой (45%) до пополнения.\n\n"
		+ "[b][color=#a78bfa]🪄 Маг-сборка (Посохи, Прокачиваемая Инта, Мантии и Книги-снаряды)[/color][/b]\n"
		+ "• Характеристику [b]🧠 Инта[/b] можно качать напрямую за очки навыков и золото во вкладке [b]Статы[/b] (доступны кнопки [b]+1 / +10 / +25 / +50 / Макс[/b] для всех стат!).\n"
		+ "• Приросты от стат усилены: [b]1 Выносливость = +60 Max HP и +16 Max MP[/b] (в 4x и 8x больше прежнего), а [b]1 Инта = +32 Max MP[/b] (8x!), +0.45 MP/с, +1.5% силы чар и урон посохов.\n"
		+ "• Посохи используют [b]📚 Книги[/b] как снаряды (при выстреле прокачивают мастерство [b]✨ Магии[/b]). Есть 2 типа книг-снарядов: [b]Тип 1[/b] (Инта + снижение манакоста) и [b]Тип 2[/b] (усиление заклинаний + продление длительности баффов и DoT).\n"
		+ "• Стартовые посохи, роба и книги продаются в Лавке, а мощнейшие посохи/облачения падают с магов-боссов (Тёмный маг, Болотная ведьма, Теневой лич, Астральный архонт) или куются навсегда в Тёмной кузне.\n\n"
		+ "[b][color=#e879f9]🔥 Тёмная кузня (Вечное снаряжение и Тёмная заточка)[/color][/b]\n"
		+ "• Доступна из меню героя и карты деревни. Здесь за [b]🌑 Очки Тьмы[/b], [b]⛏️ Руду Бездны[/b] и [b]📜 Древние листы[/b] куётся вечная экипировка (клинок, лук, посох, латы, мантия, бесконечная книга-снаряд ♾️ и [b]6 Ультимативных рецептов[/b], включая танковые латы, щит и двуручный меч бастиона с защитой от оружия!) — она [b]НЕ сбрасывается[/b] при начале Нового рана.\n"
		+ "• Здесь же можно навсегда закалить слоты Оружия и Брони (суммируется с обычной заточкой за золото): шанс 🌑+0→+1 равен 25%, +1→+2 равен [b]20%[/b] и далее падает на 1% за уровень до минимума [b]15%[/b].\n\n"
		+ "[b][color=#38bdf8]⛏️ Древняя Шахта (1 заход на ран, автобой)[/color][/b]\n"
		+ "• Открывается с Ур.3. Внутри идёт автобой, глубина растёт с каждым убитым врагом (+8% силы мобов за глубину). Пока вы сражаетесь, каждые ~5.5с можно случайно наткнуться на жилу [b]⛏️ Руды Бездны[/b], тайник с [b]📜 Древними листами[/b] или золотую жилу (плюс дроп с врагов).\n"
		+ "• Важно: даётся ровно [b]1 заход за ран[/b]! Если герой погибнет в Шахте, она обрушится и заблокируется до начала следующего рана.\n\n"
		+ "[b][color=#4ade80]🤖 Настраиваемые авто-зелья (вкладка Инвентарь)[/color][/b]\n"
		+ "• Вы можете отдельно включить и настроить: [b]Авто-HP[/b] (порог 20/35/50/70/85%, в бою или всегда), [b]Авто-MP[/b] (порог 15/30/50/70%) и [b]Авто-бафф по истечению[/b] с фильтром конкретных бафф-зелий.\n\n"
		+ "[b][color=#fbbf24]🎭 Классы героя (открываются после 50-й сложности)[/color][/b]\n"
		+ "• На Сл.50+ в меню [b]🎭 Класс героя[/b] классы можно свободно переключать в любой момент, однако [b]личные бонусы, заработанные классом, остаются строго за этим классом[/b] (не переносятся на другие классы, но сохраняются при возврате):\n"
		+ "  — [b]⚗️ Алхимик[/b]: полный иммунитет к дебафу увеличения цен («Алчность бездны»), заточка до +250, скидка 40%, шанс x1.60, усиленные зелья.\n"
		+ "  — [b]🧌 Тролль[/b]: каждый удар вешает бесконечный −1 брони (уходит в минус) + реген 2.5% HP/с в бою.\n"
		+ "  — [b]🌿 Спирит[/b]: без экипировки, +35% ко всем статам; за него сражаются 4 духа природы (Огонь, Ветер, Лес, Земля; их уровни сохраняются за Спиритом).\n"
		+ "  — [b]🎯 Снайпер Бездны[/b] и [b]🩸 Архимаг Крови[/b] (2x прирост Инты, 3x маны от Инты — 96 MP/ед. вместо 32, с шансом 10% при ударе вместо тычки кастует случайное заклинание из быстрого доступа + 7 запретных заклинаний крови из 27).\n"
		+ "  — [b]🪞 Отражатель[/b]: не умеет наносить прямой урон (ни оружием, ни боевыми чарами — только хил/баффы и эксклюзив «🪩 Зеркальный апофеоз» +200% отражения), а уклонение всегда [b]0%[/b]. Имеет [b]20x прирост HP[/b] из всех источников (включая бесконечные стаки +1 за убийство и конвертацию Барьера 1:1), +30% прироста HP и +40% брони. Входящий урон до брони рассеивается пропорционально % отражения (поглощение до [b]99%[/b], а весь % сверх 99% всё равно усиливает обратный урон врагу!). На старте боя и раз в секунду бьёт аурой на [b]5% от своего Max HP + 0.1% от Max HP врага[/b].\n\n"
		+ "[b][color=#fb7185]🦇 Тёмный магазин (ультимативные % расходники за 🪙)[/color][/b]\n"
		+ "• За каждое прохождение рана (победа над Вечным титаном) вы получаете [b]🪙 Монеты Тёмного магазина[/b] в количестве, равном пройденной сложности (Сл.5 = [b]+5 🪙[/b], Сл.10 = [b]+10 🪙[/b]). Перепроходить сложности ради монет можно бесконечно!\n"
		+ "• В [b]🦇 Тёмном магазине[/b] (в Меню героя и здании «МАГАЗИН» на карте деревни) продаются дешёвые ультимативные расходники с огромными процентами (+100% Max HP/MP, +250–350% урона и чар, +50% вампиризма и др.).\n"
		+ "• Важно: сами [b]🪙 монеты сохраняются навсегда[/b], а купленные но неиспользованные расходники [b]пропадают при начале нового рана[/b].\n\n"
		+ "[b][color=#f472b6]🐾 Путники / Питомцы (отдельный слот без HP)[/color][/b]\n"
		+ "• Путник занимает отдельный слот на арене и [b]не имеет собственного HP[/b] — он бессмертен и всегда помогает пассивным или боевым эффектом.\n"
		+ "• Путников [b]нельзя купить за золото[/b] — их можно только приманить через высадку растений в [b]☀️ Светлом саду[/b] (если узор ведёт к уже приручённому путнику — повторка ничего не даст, и растения завянут).\n"
		+ "• Собранный урожай Светлого сада используется как [b]🍪 пряники[/b] в меню «🐾 Путники» (у каждого свой любимый пряник с повышенным % шансом улучшения до +120% силы эффекта на Ур.10).\n\n"
		+ "[b][color=#38bdf8]✨ Книга заклинаний (27 чар, включая +200% отражения и высокоманазатратные)[/color][/b]\n"
		+ "• В меню [b]✨ Заклинания (27)[/b] выберите до 3 заклинаний для панели боя: от стартовых чар до могучих заклинаний под большой манапул (110–260 маны: [b]🌟 Арканный катаклизм[/b], [b]🌩️ Астральная буря[/b], [b]🌌 Звездопад забвения[/b], [b]💖 Великое возрождение[/b], [b]🔮 Возвышение архимага[/b] и [b]💥 Багровый апокалипсис[/b]), [b]🌋 Выжигание души[/b] ([b]12 тиков/с[/b]) и эксклюзива Отражателя [b]🪩 Зеркальный апофеоз[/b] (+200% отражения).\n\n"
		+ "[b][color=#2dd4bf]☀️ Светлый сад (Сл.1+) и 🌑 Тёмный сад / Зельеварение (Сл. 10+)[/color][/b]\n"
		+ "• [b]☀️ Светлый сад[/b] открыт сразу: простые семена (🍀 Клевер, 🍓 Ягода, 🌼 Ромашка, 🌶️ Перчик) падают с любых врагов (2.5%–4.5%), служат для приманки/дрессировки путников и подкормки духов.\n"
		+ "• Начиная с [b]10-й сложности[/b], вместе с первым проклятием открываются [b]🌑 Тёмный сад и многоступенчатое Зельеварение[/b] (и 4 таланта Убежища). В Тёмном саду растут мощные травы для супер-зелий, [b]🌺 Алый лепесток[/b] (2000 побед над Вечным титаном) и ультра-редкий [b]🌟 Первоцвет духов[/b] (шанс [b]0.03%[/b] ТОЛЬКО с Вечного титана; растёт 3600с, но если скормить духам по 2 шт. всех 4 базовых растений Светлого сада — созревает моментально и дрессирует 4 духов класса 🌿 Спирит).\n"
		+ "• Посаженные растения, урожай, котлы, семена, путники и уровни духов [b]НЕ пропадают при начале нового рана[/b].\n"
		+ "• Варка идёт ступенями как в Minecraft: [b]Вода → Шаг 1 → Шаг 2 → Шаг 3[/b]. Неподходящий ингредиент вызывает [b]взрыв со 100% шансом[/b] и уничтожает зелье в котле, однако класс [b]⚗️ Алхимик[/b] даёт x2 шанс семян, x2 скорость варки и строгий переключатель: [b]каждое второе неверное зелье не взрывается[/b] и остаётся на том же этапе.\n\n"
		+ "[b][color=#f43f5e]🌀 100-я сложность: Горнило Проклятий и Рероллы[/color][/b]\n"
		+ "• После достижения [b]100-й сложности[/b] справа всегда открыта бонус-локация [b]🌀 Горнило Проклятий[/b].\n"
		+ "• За каждую победу над боссом [b]Хранитель Проклятий[/b] даётся [b]+1 🎲 жетон реролла проклятия[/b], но каждый следующий призыв босса в этом ране становится сильнее (HP x1.85, урон x1.55) — фармите столько рероллов за 1 ран, сколько выдержит ваш герой!\n\n"
		+ "[b][color=#c084fc]🌳 Расходящиеся древа (44 таланта + Пресеты) и 🌑 Тёмные навыки (31)[/color][/b]\n"
		+ "• В обычном древе [b]44 узла[/b] по [b]1 ОН[/b] (включая ветки Инты, маны, защиты, урона и экономики). Сверху есть [b]3 профиля автопрокачки (П1–П3)[/b]: задайте очередь узлов и включите [b]🤖 Авто[/b], чтобы очки навыков автоматически тратились по порядку при повышении уровня и в новом ране!\n"
		+ "• В Тёмном древе добавлена ветка [b]«Бастион отражения»[/b] (5 узлов на Max HP, броню и отражение до +60% входящего урона + 2% Max HP ответного удара).\n"
		+ "• Оба древа растут из центра в разные стороны. За первую победу над Вечным титаном на [b]каждой сложности[/b] дают [b]+2 🌑[/b] (максимум 1 раз за каждую сложность — повторная зачистка уже пройденной сложности 🌑 не даёт). С любого врага с шансом [b]0.001%[/b] может выпасть вечная [b]⏳ Сфера Сброса Сумрака[/b]: при использовании она сбрасывает отметки пройденных сложностей, позволяя заново получать 🌑 за их зачистку при сохранении максимальной открытой сложности! Пресеты, тёмные навыки и жетоны реролла сохраняются между ранами навсегда.\n\n"
		+ "[b][color=#38bdf8]🛡️ Вторая рука (Щиты и Талисманы) и Барьер[/color][/b]\n"
		+ "• Добавлен слот [b]Вторая рука[/b]: [b]🛡️ Щиты[/b] (для воина/танка, добавляют броню, Max HP и Барьер) и [b]🔮 Талисманы[/b] (для мага/стрелка, дают Ману, Силу чар и Барьер — с луками/арбалетами и посохами совместимы именно талисманы).\n"
		+ "• [b]🛡️ Барьер[/b] — возобновляемый щит перед HP, автоматически восстанавливается до максимума в начале каждого боя. У [b]🪞 Отражателя[/b] весь Барьер конвертируется [b]1:1 в Max HP[/b] (с учётом x20 прироста HP).\n\n"
		+ "[b][color=#facc15]⭐ Качество предметов (100 шт.), Авто-разбор и 🌑 Слияние дубликатов[/color][/b]\n"
		+ "• Выпавшие предметы экипировки получают случайное [b]Качество (80%–125%)[/b], напрямую масштабирующее статы; слияние в Кузне повышает звёзды ([b]★1 → ★5[/b], по +10% за звезду).\n"
		+ "• В Инвентаре можно включить [b]Авто-разбор[/b]: слабые и обычные дубликаты при выпадении автоматически превращаются в золото и [b]🔹 Осколки Бездны[/b] ([b]10 осколков → 1 ⛏️ Руда Бездны[/b] в Тёмной кузне).\n"
		+ "• В Тёмной кузне доступны [b]6 Ультимативных вечных рецептов[/b] (клинки, талисман, танковые латы и щит с Выносливостью/бронёй) — они требуют не только ресурсы Шахты, но и поглощают редкое снаряжение.\n\n"
		+ "[b][color=#a78bfa]📖 Бестиарий, Прокачка заклинаний (Ур.1–5) и Руны (A/B)[/color][/b]\n"
		+ "• [b]📖 Бестиарий[/b] считает победы над всеми 26 видами врагов: на отметках [b]100 / 1 000 / 10 000[/b] убийств даёт постоянные бонусы урона (+2%/+6%/+11%), золота (+3%) и дропа (+10%) против этого врага.\n"
		+ "• Каждое из 27 заклинаний качается до [b]Ур.5[/b] (до +60% силы) автоматически от применений или мгновенно за [b]📜 Древние листы[/b], а также имеет по [b]2 Руны (A/B)[/b], меняющих манакост, КД, длительность, барьер или вампиризм.\n\n"
		+ "[b][color=#fb923c]🧭 Авто-маршрут, Данж 10 волн, Чекпоинты, Колодец, Комплекты и Экспедиции[/color][/b]\n"
		+ "• [b]🎒 3 Боевых комплекта (К1–К3)[/b] сверху меню героя моментально переключают класс, оружие, броню, вторую руку, снаряды, заклинания и путника.\n"
		+ "• [b]🧭 Авто-маршрут[/b] (в правом меню карты) после N побед подряд (3/5/10/20) переводит на следующую открытую локацию и автоматически отступает назад при критическом HP.\n"
		+ "• [b]🏰 Данж волн[/b]: 10 последовательных волн с боссом на 10-й и сундуком с Рудой, Листами и талисманом/щитом.\n"
		+ "• [b]⛏️ Чекпоинты Шахты (10 / 25 / 50)[/b]: открываются навсегда за Руду Бездны и позволяют начинать заход в Шахту сразу с выбранной глубины.\n"
		+ "• [b]⛲ Колодец Жадности[/b] (на карте деревни) принимает всё золото рана (от 100 з., КД 15 мин) взамен на Руду, Листы, Рероллы, редкие семена и благословение до конца рана.\n"
		+ "• [b]🧭 Экспедиции путников[/b] (в Убежище): свободные питомцы уходят на 15 мин или 1 час и приносят золото, семена, Руду Бездны и Листы.\n"
		+ "• [b]🔥 Испытания Бездны[/b] (в Новом ране): 4 челленджа (Спидран ≤5 мин, Без зелий, Только посохи, Без экипировки) за постоянные награды 🌑 и 🪙.\n"
		+ "• [b]⚡ Мобильный AFK и FPS[/b]: в оверлее AFK можно выбрать лимит FPS ([b]15 / 30 / 60[/b]), при активном оверлее тяжелые обновления полос на арене полностью пропускаются."
	)
