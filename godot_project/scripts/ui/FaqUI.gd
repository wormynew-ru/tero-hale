extends ScrollContainer

@onready var faq_text: RichTextLabel = %FaqText


func _ready() -> void:
	if faq_text != null:
		faq_text.text = _build_faq_bbcode()


func _build_faq_bbcode() -> String:
	return (
		"[b][color=#facc15]⚔️ Поиск боя и честный автобой[/color][/b]\n"
		+ "• Кнопка [b]⚔️ Поиск боя[/b] по центру экрана запускает сражения в выбранной локации. Пока бой активен, кнопка меняется на [b]🏳️ Отступить[/b].\n"
		+ "• Персонаж сражается полностью самостоятельно в реальном времени — кликами ускорить атаку нельзя.\n\n"
		+ "[b][color=#60a5fa]📘 Learn by Doing (Мастерство из практики)[/color][/b]\n"
		+ "• В игре есть 3 навыка владения, которые качаются сами по мере использования:\n"
		+ "  — [b]⚔️ Ближний бой[/b]: +1 XP за удар оружием ближнего боя (+3% урона за уровень).\n"
		+ "  — [b]🏹 Дальний бой[/b]: +1 XP за выстрел со снарядом (+3.5% урона и +0.3% крита за уровень).\n"
		+ "  — [b]✨ Магия[/b]: +XP равный затраченной мане (заклинание за 20 маны даёт 20 XP; +3.5% силы чар и +4% регена маны за уровень).\n\n"
		+ "[b][color=#34d399]🏹 Дальний бой (Луки, Арбалеты и Снаряды)[/color][/b]\n"
		+ "• Луки используют [b]Стрелы[/b], арбалеты — [b]Болты[/b]. Купите колчан в лавке (пачки по 50 шт.) или выбейте с врагов.\n"
		+ "• При наличии подходящих снарядов они добавляют урон, крит и пробитие брони. Если снаряды закончились — герой бьёт ослабленной атакой (45%) до пополнения.\n\n"
		+ "[b][color=#a78bfa]🪄 Маг-сборка (Посохи, Инта, Мантии и Книги-снаряды)[/color][/b]\n"
		+ "• Посохи используют [b]📚 Книги[/b] как снаряды (при выстреле прокачивают мастерство [b]✨ Магии[/b]) и наносят урон от характеристики [b]🧠 Инта[/b] (каждая ед. Инты даёт +4 Max MP, +0.45 MP/с, +1.5% силы чар и урон посоха).\n"
		+ "• Есть 2 типа книг-снарядов: [b]Тип 1[/b] (Инта + снижение манакоста) и [b]Тип 2[/b] (усиление заклинаний + продление длительности баффов и DoT).\n"
		+ "• Стартовые посохи, роба и книги продаются в Лавке, а мощнейшие посохи/облачения падают с магов-боссов (Тёмный маг, Болотная ведьма, Теневой лич, Астральный архонт) или куются навсегда в Тёмной кузне.\n\n"
		+ "[b][color=#e879f9]🔥 Тёмная кузня (Вечное снаряжение и Тёмная заточка)[/color][/b]\n"
		+ "• Доступна из меню героя и карты деревни. Здесь за [b]🌑 Очки Тьмы[/b], [b]⛏️ Руду Бездны[/b] и [b]📜 Древние листы[/b] куётся вечная экипировка (клинок, лук, посох, латы, мантия и бесконечная книга-снаряд ♾️) — она [b]НЕ сбрасывается[/b] при начале Нового рана.\n"
		+ "• Здесь же можно навсегда закалить слоты Оружия и Брони (суммируется с обычной заточкой за золото): шанс 🌑+0→+1 равен 25%, +1→+2 равен [b]20%[/b] и далее падает на 1% за уровень до минимума [b]15%[/b].\n\n"
		+ "[b][color=#38bdf8]⛏️ Древняя Шахта (1 заход на ран, автобой)[/color][/b]\n"
		+ "• Открывается с Ур.3. Внутри идёт автобой, глубина растёт с каждым убитым врагом (+8% силы мобов за глубину). Пока вы сражаетесь, каждые ~5.5с можно случайно наткнуться на жилу [b]⛏️ Руды Бездны[/b], тайник с [b]📜 Древними листами[/b] или золотую жилу (плюс дроп с врагов).\n"
		+ "• Важно: даётся ровно [b]1 заход за ран[/b]! Если герой погибнет в Шахте, она обрушится и заблокируется до начала следующего рана.\n\n"
		+ "[b][color=#4ade80]🤖 Настраиваемые авто-зелья (вкладка Инвентарь)[/color][/b]\n"
		+ "• Вы можете отдельно включить и настроить: [b]Авто-HP[/b] (порог 20/35/50/70/85%, в бою или всегда), [b]Авто-MP[/b] (порог 15/30/50/70%) и [b]Авто-бафф по истечению[/b] с фильтром конкретных бафф-зелий.\n\n"
		+ "[b][color=#fbbf24]🎭 Классы героя (открываются после 50-й сложности)[/color][/b]\n"
		+ "• На Сл.50+ в меню [b]🎭 Класс героя[/b] доступны уникальные классы:\n"
		+ "  — [b]⚗️ Алхимик[/b]: заточка до +250, скидка 40%, шанс x1.60, усиленные зелья.\n"
		+ "  — [b]🧌 Тролль[/b]: каждый удар вешает бесконечный −1 брони (уходит в минус) + реген 2.5% HP/с в бою.\n"
		+ "  — [b]🌿 Спирит[/b]: без экипировки, +35% ко всем статам; за него сражаются 4 духа природы (Огонь, Ветер, Лес, Земля).\n"
		+ "  — [b]🎯 Снайпер Бездны[/b] и [b]🩸 Архимаг Крови[/b] (открывает 6 запретных заклинаний крови из 20).\n"
		+ "  — [b]🪞 Отражатель[/b]: не умеет наносить прямой урон (ни оружием, ни боевыми чарами — только хил/баффы). Вместо этого +30% HP, +40% брони, отражает [b]20%[/b] любого входящего урона, каждую секунду бьёт на [b]5% от своего Max HP[/b] и вызывает гниение врага на [b]0.1% от его Max HP/с[/b].\n\n"
		+ "[b][color=#f472b6]🐾 Путники / Питомцы (отдельный слот без HP)[/color][/b]\n"
		+ "• Путник занимает отдельный слот на арене и [b]не имеет собственного HP[/b] — он бессмертен и всегда помогает пассивным или боевым эффектом.\n"
		+ "• Путников [b]нельзя купить за золото[/b] — их можно только приманить через высадку растений в [b]☀️ Светлом саду[/b] (если узор ведёт к уже приручённому путнику — повторка ничего не даст, и растения завянут).\n"
		+ "• Собранный урожай Светлого сада используется как [b]🍪 пряники[/b] в меню «🐾 Путники» (у каждого свой любимый пряник с повышенным % шансом улучшения до +120% силы эффекта на Ур.10).\n\n"
		+ "[b][color=#38bdf8]✨ Книга заклинаний (20 чар, максимум 3 активных слота)[/color][/b]\n"
		+ "• В меню [b]✨ Заклинания (20)[/b] выберите до 3 заклинаний для панели боя: прямой урон, лечение, [b]баффы[/b], яд/кровотечение и [b]🌋 Выжигание души[/b] (бёрст-перегрузка [b]12 тиков/с[/b], до 12 тиков за 1с: растущий урон ценой 1/1 → 2/2 → 4/4+1 → 8/8+2 HP и маны за тик).\n\n"
		+ "[b][color=#2dd4bf]☀️ Светлый сад (Сл.1+) и 🌑 Тёмный сад / Зельеварение (Сл. 10+)[/color][/b]\n"
		+ "• [b]☀️ Светлый сад[/b] открыт сразу: простые семена (🍀 Клевер, 🍓 Ягода, 🌼 Ромашка, 🌶️ Перчик) падают с любых врагов (2.5%–4.5%), служат для приманки/дрессировки путников и подкормки духов.\n"
		+ "• Начиная с [b]10-й сложности[/b], вместе с первым проклятием открываются [b]🌑 Тёмный сад и многоступенчатое Зельеварение[/b] (и 4 таланта Убежища). В Тёмном саду растут мощные травы для супер-зелий, [b]🌺 Алый лепесток[/b] (2000 побед над Вечным титаном) и ультра-редкий [b]🌟 Первоцвет духов[/b] (шанс [b]0.03%[/b] ТОЛЬКО с Вечного титана; растёт 3600с, но если скормить духам по 2 шт. всех 4 базовых растений Светлого сада — созревает моментально и дрессирует 4 духов класса 🌿 Спирит).\n"
		+ "• Посаженные растения, урожай, котлы, семена, путники и уровни духов [b]НЕ пропадают при начале нового рана[/b].\n"
		+ "• Варка идёт ступенями как в Minecraft: [b]Вода → Шаг 1 → Шаг 2 → Шаг 3[/b]. Неподходящий ингредиент вызывает [b]взрыв со 100% шансом[/b] и уничтожает зелье в котле, однако класс [b]⚗️ Алхимик[/b] даёт x2 шанс семян, x2 скорость варки и строгий переключатель: [b]каждое второе неверное зелье не взрывается[/b] и остаётся на том же этапе.\n\n"
		+ "[b][color=#f43f5e]🌀 100-я сложность: Горнило Проклятий и Рероллы[/color][/b]\n"
		+ "• После достижения [b]100-й сложности[/b] справа всегда открыта бонус-локация [b]🌀 Горнило Проклятий[/b].\n"
		+ "• За каждую победу над боссом [b]Хранитель Проклятий[/b] даётся [b]+1 🎲 жетон реролла проклятия[/b], но каждый следующий призыв босса в этом ране становится сильнее (HP x1.85, урон x1.55) — фармите столько рероллов за 1 ран, сколько выдержит ваш герой!\n\n"
		+ "[b][color=#c084fc]🌳 Расходящиеся древа талантов и 🌑 Тёмные навыки[/color][/b]\n"
		+ "• Каждый узел обычного древа талантов стоит [b]1 ОН[/b] и даёт мощный прирост характеристик, крита, маны, урона, золота и опыта.\n"
		+ "• Оба древа растут из центра в разные стороны. За первую победу над Вечным титаном на [b]каждой сложности[/b] дают [b]+2 🌑[/b] (максимум 1 раз за каждую сложность — повторная зачистка уже пройденной сложности 🌑 не даёт). Тёмные навыки и жетоны реролла сохраняются между ранами навсегда."
	)
